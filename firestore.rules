rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Users collection: users can read/create own profile (non-admin role), never escalate role/eligibility
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.role == 'user'
        && request.resource.data.isEligibleMember == false;
      allow update: if isOwner(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.isEligibleMember == resource.data.isEligibleMember
        && request.resource.data.subscriptionStatus == resource.data.subscriptionStatus
        && request.resource.data.accountStatus == resource.data.accountStatus;
      allow delete: if false;
    }

    match /admins/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /packs/{packId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /inventory/{projectId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /app_settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Payment requests: users can create pending requests for themselves; only backend approves/rejects
    match /payment_requests/{reqId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.quantity >= 1
        && request.resource.data.totalAmount > 0;
      allow update, delete: if false;
    }

    // Financial & Ledger collections: strictly written by trusted Cloud Functions
    match /ownership_records/{recordId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /wallets/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    match /ledger_entries/{entryId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /sales/{saleId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /expenses/{expenseId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /withdrawal_requests/{reqId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /buyback_requests/{reqId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /subscriptions/{monthKey} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /subscription_invoices/{invId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /referral_relationships/{relId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.referrerId == request.auth.uid);
      allow write: if false;
    }

    match /notifications/{notifId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow create, delete: if false;
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
